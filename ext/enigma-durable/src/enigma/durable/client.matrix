note suite "enigma.durable.client"
write_receipts_distinguish_confirmed_rejection_from_malformed_output begin test
    value written is success_fixture with nothing
    evaluate written.put_number with key being "revision", input being 1
    evaluate written.put_number with key being "evidence_id", input being 1
    evaluate written.put_number with key being "event_id", input being 1
    value parsed is decode_write with node being written.node
    expect not (parsed.is_error with nothing)
    expect (parsed.unwrap with nothing).evidence_id equals 1
    evaluate written.put_text with key being "event_id", input being "1"
    expect (decode_write with node being written.node).is_error with nothing
    value denied is rejection_fixture with code being "denied"
    value refused is decode_write with node being denied.node
    expect not (refused.is_error with nothing)
    expect (refused.unwrap with nothing).code equals "denied"
    expect (refused.unwrap with nothing).revision equals 0
    evaluate denied.put_number with key being "generation", input being 9
    expect (decode_write with node being denied.node).is_error with nothing
    value leaked is rejection_fixture with code being "conflict"
    evaluate leaked.put_number with key being "revision", input being 1
    evaluate leaked.put_number with key being "evidence_id", input being 0
    evaluate leaked.put_number with key being "event_id", input being 0
    expect (decode_write with node being leaked.node).is_error with nothing
end test

note suite "enigma.durable.client"
resolution_decoding_preserves_completeness_and_rejects_false_verdicts begin test
    value node is success_fixture with nothing
    evaluate node.put_text with key being "state", input being "supported"
    evaluate node.put_number with key being "revision", input being 1
    evaluate node.put with key being "complete", input being (boolean_value with yes).unwrap with nothing
    evaluate node.put with key being "evidence_complete", input being (boolean_value with yes).unwrap with nothing
    evaluate node.put_number with key being "inspected", input being 1
    evaluate node.put_number with key being "supporting", input being 1
    evaluate node.put_number with key being "opposing", input being 0
    value first is (integer_value with "1").unwrap with nothing
    value ids is (array_append with (new_array with nothing).unwrap with nothing, first).unwrap with nothing
    evaluate node.put with key being "evidence_ids", input being ids
    value parsed is decode_resolution with node being node.node
    expect not (parsed.is_error with nothing)
    expect (parsed.unwrap with nothing).state equals "supported"
    evaluate node.put with key being "complete", input being (boolean_value with no).unwrap with nothing
    expect (decode_resolution with node being node.node).is_error with nothing
    evaluate node.put_text with key being "state", input being "incomplete"
    evaluate node.put with key being "evidence_complete", input being (boolean_value with no).unwrap with nothing
    value partial is decode_resolution with node being node.node
    expect not (partial.is_error with nothing)
    expect not (partial.unwrap with nothing).complete
    expect (partial.unwrap with nothing).supporting equals 1
end test

note suite "enigma.durable.client"
discovery_decoding_keeps_provenance_and_requires_active_ordered_reports begin test
    value row is fixture_evidence_json with nothing
    value rows is (array_append with (new_array with nothing).unwrap with nothing, row.node).unwrap with nothing
    value node is success_fixture with nothing
    evaluate node.put_number with key being "revision", input being 1
    evaluate node.put_number with key being "retained_from", input being 0
    evaluate node.put with key being "complete", input being (boolean_value with yes).unwrap with nothing
    evaluate node.put with key being "evidence_complete", input being (boolean_value with yes).unwrap with nothing
    evaluate node.put_number with key being "inspected", input being 1
    evaluate node.put_number with key being "matched", input being 1
    evaluate node.put with key being "items", input being rows
    value parsed is decode_discovery with node being node.node
    expect parsed.valid
    value report is (parsed.receipt.items.get with index being 0).unwrap with nothing
    expect report.source equals "synthetic:receipt"
    expect report.session equals 7
    value duplicate is (array_append with rows, row.node).unwrap with nothing
    evaluate node.put with key being "items", input being duplicate
    evaluate node.put_number with key being "matched", input being 2
    evaluate node.put_number with key being "inspected", input being 2
    expect not (decode_discovery with node being node.node).valid
    evaluate node.put with key being "items", input being rows
    evaluate node.put_number with key being "matched", input being 1
    evaluate node.put_number with key being "inspected", input being 1
    evaluate node.put_number with key being "retained_from", input being 2
    expect not (decode_discovery with node being node.node).valid
end test

note suite "enigma.durable.client"
inspection_grants_and_compaction_have_checked_result_shapes begin test
    value inspection is success_fixture with nothing
    evaluate inspection.put_number with key being "revision", input being 1
    evaluate inspection.child with key being "evidence", input being (fixture_evidence_json with nothing)
    expect not ((decode_inspection with node being inspection.node).is_error with nothing)
    value row is fixture_evidence_json with nothing
    evaluate row.put_number with key being "asserted_at", input being 2
    evaluate inspection.child with key being "evidence", input being row
    expect (decode_inspection with node being inspection.node).is_error with nothing
    value granted is success_fixture with nothing
    evaluate granted.put_number with key being "grant_id", input being 1
    expect not ((decode_grant with node being granted.node).is_error with nothing)
    evaluate granted.put_number with key being "grant_id", input being 0
    expect (decode_grant with node being granted.node).is_error with nothing
    value compacted is success_fixture with nothing
    evaluate compacted.put_number with key being "revision", input being 3
    evaluate compacted.put_number with key being "reclaimed", input being 2
    evaluate compacted.put_number with key being "retained_from", input being 3
    expect not ((decode_compaction with node being compacted.node).is_error with nothing)
    evaluate compacted.put_number with key being "retained_from", input being 4
    expect (decode_compaction with node being compacted.node).is_error with nothing
end test


note suite "enigma.durable.client"
uniform_replies_separate_confirmation_from_failure_and_clear_metadata begin test
    value issue is failure with code being "storage_error", outcome_unknown being yes
    value rejected_write is write_failed with issue being issue
    expect not rejected_write.confirmed
    expect rejected_write.failure.code equals "storage_error"
    expect rejected_write.failure.outcome_unknown
    expect rejected_write.receipt.code equals "storage_error"
    expect rejected_write.receipt.revision equals 0
    expect rejected_write.receipt.evidence_id equals 0
    value rejected_discovery is discovery_failed with issue being issue
    expect not rejected_discovery.confirmed
    expect rejected_discovery.receipt.code equals "storage_error"
    expect rejected_discovery.receipt.revision equals 0
    expect rejected_discovery.receipt.retained_from equals 0
    expect not rejected_discovery.receipt.complete
    expect (rejected_discovery.receipt.items.count with nothing) equals 0
    value confirmed_denial is discovery_confirmed with receipt being (blank_discovery with code being "denied")
    expect confirmed_denial.confirmed
    expect confirmed_denial.receipt.code equals "denied"
    expect confirmed_denial.failure.code equals ""
    expect not confirmed_denial.failure.outcome_unknown
end test


note suite "enigma.durable.client"
expanded_scan_counts_keep_the_reply_bound_independent begin test
    value scan is success_fixture with nothing
    evaluate scan.put_text with key being "state", input being "supported"
    evaluate scan.put_number with key being "revision", input being 1024
    evaluate scan.put with key being "complete", input being (boolean_value with yes).unwrap with nothing
    evaluate scan.put with key being "evidence_complete", input being (boolean_value with no).unwrap with nothing
    evaluate scan.put_number with key being "inspected", input being 1024
    evaluate scan.put_number with key being "supporting", input being 1024
    evaluate scan.put_number with key being "opposing", input being 0
