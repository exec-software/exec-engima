success_fixture returns request_builder begin paragraph
    value node is new_request with nothing
    evaluate node.put_text with key being "code", input being "ok"
    evaluate node.put_text with key being "instance", input being "incarnation:test"
    evaluate node.put_text with key being "database_id", input being "database:test"
    evaluate node.put_number with key being "generation", input being 1
    give node
end paragraph

