    value ids is (array_append with (new_array with nothing).unwrap with nothing, identifier).unwrap with nothing
    evaluate scan.put with key being "evidence_ids", input being ids
    value resolved is decode_resolution with node being scan.node
    expect not (resolved.is_error with nothing)
    expect (resolved.unwrap with nothing).inspected equals 1024
    expect not (resolved.unwrap with nothing).evidence_complete
    variable oversized_ids is (new_array with nothing).unwrap with nothing
    repeat for index from 0 to 129
        value amount is 129 minus index
        value item is (integer_value with formatted "{amount}").unwrap with nothing
        set oversized_ids to (array_append with oversized_ids, item).unwrap with nothing
    end repeat
    evaluate scan.put with key being "evidence_ids", input being oversized_ids
    expect (decode_resolution with node being scan.node).is_error with nothing
    evaluate scan.put with key being "evidence_ids", input being ids
    evaluate scan.put_number with key being "inspected", input being 1025
    expect (decode_resolution with node being scan.node).is_error with nothing
    value discovery is success_fixture with nothing
    evaluate discovery.put_number with key being "revision", input being 1024
    evaluate discovery.put_number with key being "retained_from", input being 0
    evaluate discovery.put with key being "complete", input being (boolean_value with yes).unwrap with nothing
    evaluate discovery.put with key being "evidence_complete", input being (boolean_value with no).unwrap with nothing
    evaluate discovery.put_number with key being "inspected", input being 1024
    evaluate discovery.put_number with key being "matched", input being 1024
    value rows is (array_append with (new_array with nothing).unwrap with nothing, (fixture_evidence_json with nothing).node).unwrap with nothing
    evaluate discovery.put with key being "items", input being rows
    expect (decode_discovery with node being discovery.node).valid
    evaluate discovery.put_number with key being "inspected", input being 1025
    expect not (decode_discovery with node being discovery.node).valid
    value compacted is success_fixture with nothing
    evaluate compacted.put_number with key being "revision", input being 1024
    evaluate compacted.put_number with key being "reclaimed", input being 1024
    evaluate compacted.put_number with key being "retained_from", input being 1024
    expect not ((decode_compaction with node being compacted.node).is_error with nothing)
    evaluate compacted.put_number with key being "reclaimed", input being 1025
    expect (decode_compaction with node being compacted.node).is_error with nothing
end test
