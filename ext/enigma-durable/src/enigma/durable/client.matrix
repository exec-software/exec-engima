rejection_fixture receives code as text returns request_builder begin paragraph
    value node is new_request with nothing
    evaluate node.put_text with key being "code", input being code
    evaluate node.put_text with key being "instance", input being ""
    evaluate node.put_number with key being "generation", input being 0
    give node
end paragraph

note if_test_mode
fixture_evidence_json returns request_builder begin paragraph
    value node is new_request with nothing
    evaluate node.put_number with key being "id", input being 1
    evaluate node.put_text with key being "subject", input being "subject:test"
    evaluate node.put_text with key being "relation", input being "reports"
    evaluate node.put_text with key being "object_value", input being "ready"
    evaluate node.put with key being "supports", input being (boolean_value with yes).unwrap with nothing
    evaluate node.put_text with key being "source", input being "synthetic:receipt"
    evaluate node.put_text with key being "entity", input being "agent:test"
    evaluate node.put_number with key being "session", input being 7
    evaluate node.put_number with key being "asserted_at", input being 1
    evaluate node.put_number with key being "withdrawn_at", input being 0
