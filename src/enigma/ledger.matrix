book enigma.ledger

read authority_registry, access_context, open_authority from enigma.authority

public proposition begin record
    field subject as text
    field relation as text
    field object_value as text
end record

public evidence_item begin record
    field id as number
    field subject as text
    field relation as text
    field object_value as text
    field supports as boolean
    field source as text
    field entity as text
    field session as number
    field asserted_at as number
    field withdrawn_at as number
end record

public write_receipt begin record
    field code as text
    field revision as number
    field evidence_id as number
    field event_id as number
end record

public resolution begin record
    field code as text
    field state as text
    field revision as number
    field complete as boolean
    field evidence_complete as boolean
    field inspected as number
    field supporting as number
    field opposing as number
    field evidence_ids as array of number
end record

public inspect_receipt begin record
    field code as text
    field revision as number
    field evidence as evidence_item
end record

valid_text receives input as text returns boolean begin paragraph
    give (the length of input) is greater than 0 and (the length of input) is at most 256
end paragraph

valid_proposition receives claim as proposition returns boolean begin paragraph
    give (valid_text with input being claim.subject) and
        (valid_text with input being claim.relation) and
        (valid_text with input being claim.object_value)
end paragraph

empty_proposition returns proposition begin paragraph
    give build proposition with subject being "", relation being "", object_value being ""
end paragraph

failed_write receives code as text returns write_receipt begin paragraph
    give build write_receipt with code being code, revision being 0, evidence_id being 0, event_id being 0
end paragraph

failed_resolution receives code as text returns resolution begin paragraph
    give build resolution with code being code, state being "unavailable", revision being 0,
        complete being no, evidence_complete being no, inspected being 0,
        supporting being 0, opposing being 0, evidence_ids being []
end paragraph

failed_inspect receives code as text returns inspect_receipt begin paragraph
    value blank is build evidence_item with id being 0, subject being "", relation being "",
        object_value being "", supports being no, source being "", entity being "",
        session being 0, asserted_at being 0, withdrawn_at being 0
    give build inspect_receipt with code being code, revision being 0, evidence being blank
end paragraph

!!! Trusted host state: Matrix fields are publicly accessible. Only API mediation
!!! is tested here; hostile same-process memory access requires native isolation.
public evidence_store begin class
    field scope_name as text
    field revision_value as number
    !!! ENI-0005. revision_value stays the logical clock and the as-of
    !!! coordinate, so it only increases and nothing is ever renumbered.
    !!! event_ids carries each retained event's issued revision, and
    !!! retained_from is the horizon below which a view can no longer be
    !!! reconstructed, where a read answers incomplete instead of guessing.
    field retained_from as number
    field event_ids as array of number
    field event_kinds as array of number
    field subjects as array of text
    field relations as array of text
    field objects as array of text
    field polarities as array of number
    field sources as array of text
    field entities as array of text
    field sessions as array of number
    field targets as array of number

    !!! The row holding an event, or minus 1. Compaction leaves gaps, so a
    !!! revision is no longer an offset into these arrays.
    position_of receives event_id as number returns number begin paragraph
        repeat for index from 0 to (the length of my event_ids)
            when (my event_ids at index) equals event_id then
                give index
            end when
        end repeat
        give minus 1
    end paragraph

    !!! What the ceiling and the scan budget both count: events still held,
    !!! rather than every event ever written.
    public retained_count returns number begin paragraph
        give the length of my event_ids
    end paragraph

    append_event receives claim as proposition, polarity as number, source as text,
        entity as text, session as number, kind as number, target as number returns number begin paragraph
        set my revision_value to my revision_value plus 1
        append my revision_value to my event_ids
        append kind to my event_kinds
        append claim.subject to my subjects
        append claim.relation to my relations
        append claim.object_value to my objects
        append polarity to my polarities
        append source to my sources
        append entity to my entities
        append session to my sessions
        append target to my targets
        give my revision_value
    end paragraph

    public assert_claim receives authority as authority_registry, caller as access_context,
        grant_id as number, scope as text, claim as proposition, supports as boolean,
        source as text, expected_revision as number returns write_receipt begin paragraph
        value access is authority.authorize with caller being caller, grant_id being grant_id,
            scope being scope, operation being 2
        when access.code does not equal "ok" then
            give failed_write with code being "denied"
        end when
        when scope does not equal my scope_name then
            give failed_write with code being "denied"
        end when
        when not (valid_proposition with claim being claim) or not (valid_text with input being source) or
            expected_revision is less than minus 1 then
            give failed_write with code being "invalid"
        end when
        when expected_revision does not equal minus 1 and expected_revision does not equal my revision_value then
            give failed_write with code being "conflict"
        end when
        !!! Keep the final retained-event slot available for a withdrawal.
        !!! Reclaiming that pair still requires explicit compaction authority.
        when (my retained_count with nothing) is at least 1023 then
            give failed_write with code being "capacity"
        end when
        variable polarity as number is 0
        when supports then
            set polarity to 1
        end when
        value next_id is my append_event with claim being claim, polarity being polarity, source being source,
            entity being access.entity, session being caller.session, kind being 1, target being 0
        give build write_receipt with code being "ok", revision being next_id, evidence_id being next_id, event_id being next_id
    end paragraph

    public withdraw receives authority as authority_registry, caller as access_context,
        grant_id as number, scope as text, evidence_id as number, expected_revision as number returns write_receipt begin paragraph
        value access is authority.authorize with caller being caller, grant_id being grant_id,
            scope being scope, operation being 4
        when access.code does not equal "ok" or scope does not equal my scope_name then
            give failed_write with code being "denied"
        end when
        when expected_revision is less than minus 1 or evidence_id is less than 1 then
            give failed_write with code being "invalid"
        end when
        when expected_revision does not equal minus 1 and expected_revision does not equal my revision_value then
            give failed_write with code being "conflict"
        end when
        !!! The scan walks retained events, so that is what the budget bounds.
        when (my retained_count with nothing) is greater than access.work_limit then
            give failed_write with code being "limit"
        end when
        when evidence_id is greater than my revision_value then
            give failed_write with code being "denied"
        end when
        value position is my position_of with event_id being evidence_id
        !!! A reclaimed assertion cannot be withdrawn again. It was already
        !!! retired, which is precisely why it was reclaimable.
        when position is less than 0 then
            give failed_write with code being "denied"
        end when
        when (my event_kinds at position) does not equal 1 or (my entities at position) does not equal access.entity then
            give failed_write with code being "denied"
        end when
        variable index as number is position plus 1
        repeat while index is less than (my retained_count with nothing)
            when (my event_kinds at index) equals 2 and (my targets at index) equals evidence_id then
                give failed_write with code being "denied"
            end when
            set index to index plus 1
        end repeat
        when (my retained_count with nothing) is at least 1024 then
            give failed_write with code being "capacity"
        end when
        value blank is empty_proposition with nothing
        value next_id is my append_event with claim being blank, polarity being 0, source being "",
            entity being access.entity, session being caller.session, kind being 2, target being evidence_id
        give build write_receipt with code being "ok", revision being next_id, evidence_id being evidence_id, event_id being next_id
    end paragraph

    public resolve receives authority as authority_registry, caller as access_context,
        grant_id as number, scope as text, claim as proposition, as_of as number,
        max_work as number, max_evidence as number returns resolution begin paragraph
        value access is authority.authorize with caller being caller, grant_id being grant_id,
            scope being scope, operation being 1
        when access.code does not equal "ok" or scope does not equal my scope_name then
            give failed_resolution with code being "denied"
        end when
        when not (valid_proposition with claim being claim) or as_of is less than minus 1 or
            max_work is less than 1 or max_work is greater than 1024 or
            max_evidence is less than 1 or max_evidence is greater than 128 then
            give failed_resolution with code being "invalid"
        end when
        when max_work is greater than access.work_limit or max_evidence is greater than access.result_limit then
            give failed_resolution with code being "denied"
        end when
        variable snapshot as number is as_of
        when snapshot equals minus 1 then
            set snapshot to my revision_value
        end when
        when snapshot is greater than my revision_value then
            give failed_resolution with code being "invalid"
        end when

        variable withdrawn as array of number is []
        variable ids as array of number is []
        !!! Retained events stay in ascending revision order, so walking the
        !!! array backwards still visits newer events first, which is what
        !!! lets a withdrawal be seen before the assertion it retires.
        variable index as number is (my retained_count with nothing) minus 1
        variable inspected as number is 0
        variable supporting as number is 0
        variable opposing as number is 0
        repeat while index is at least 0 and inspected is less than max_work
            !!! Later than the requested view, so outside it. Skipping spends
            !!! no budget: the caller asked for a smaller history, not more work.
            when (my event_ids at index) is greater than snapshot then
                set index to index minus 1
            otherwise
            set inspected to inspected plus 1
            when (my event_kinds at index) equals 2 then
                append (my targets at index) to withdrawn
            end when
            when (my event_kinds at index) equals 1 then
                when (my subjects at index) equals claim.subject and (my relations at index) equals claim.relation and
                    (my objects at index) equals claim.object_value then
                    value evidence_id is my event_ids at index
                    variable active as boolean is yes
                    repeat for each target in withdrawn
                        when target equals evidence_id then
                            set active to no
                        end when
                    end repeat
                    when active then
                        when (my polarities at index) equals 1 then
                            set supporting to supporting plus 1
                        otherwise
                            set opposing to opposing plus 1
                        end when
                        when (the length of ids) is less than max_evidence then
                            append evidence_id to ids
                        end when
                    end when
                end when
            end when
            set index to index minus 1
            end when
        end repeat
        !!! A finished scan is an exact answer only when the store can still
        !!! reconstruct the requested view. Revision 0 needs no reconstruction:
        !!! nothing had been written, so an empty snapshot stays exact whatever
        !!! has since been reclaimed.
        value reconstructable is snapshot equals 0 or snapshot is at least my retained_from
        value complete is index is less than 0 and reconstructable
        variable state as text is "incomplete"
        when complete then
            set state to "unknown"
            when supporting is greater than 0 and opposing is greater than 0 then
                set state to "contested"
            end when
            when supporting is greater than 0 and opposing equals 0 then
                set state to "supported"
            end when
            when opposing is greater than 0 and supporting equals 0 then
                set state to "contradicted"
            end when
        end when
        value evidence_complete is complete and (the length of ids) equals supporting plus opposing
        give build resolution with code being "ok", state being state, revision being snapshot,
            complete being complete, evidence_complete being evidence_complete, inspected being inspected,
            supporting being supporting, opposing being opposing, evidence_ids being ids
    end paragraph

    !!! ENI-0005. Reclaim every assertion whose withdrawal is also still held.
    !!! Such a pair contributes nothing to any view at or after the
    !!! withdrawal, so removing both changes no answer the store still claims
    !!! to give. An assertion nobody retracted is never reclaimed, whatever
    !!! its age: it is still evidence.
    !!!
    !!! The horizon moves only as far as it must, to the newest withdrawal
    !!! reclaimed. A view at or after that is still exact; one below it is
    !!! conservatively refused, because a reclaimed assertion may have been
    !!! active there.
    public compact receives authority as authority_registry, caller as access_context,
        grant_id as number, scope as text returns write_receipt begin paragraph
        !!! Compaction forgets history across the scope. Dedicated maintenance
        !!! authority keeps withdraw-own grants from gaining that power.
        value access is authority.authorize with caller being caller, grant_id being grant_id,
            scope being scope, operation being 16
        when access.code does not equal "ok" or scope does not equal my scope_name then
            give failed_write with code being "denied"
        end when
        when (my retained_count with nothing) is greater than access.work_limit then
            give failed_write with code being "limit"
        end when
        variable doomed as array of number is []
        variable horizon as number is my retained_from
        repeat for index from 0 to (the length of my event_ids)
            when (my event_kinds at index) equals 2 then
                value target is my targets at index
                when (my position_of with event_id being target) is at least 0 then
                    append target to doomed
                    append (my event_ids at index) to doomed
                    when (my event_ids at index) is greater than horizon then
                        set horizon to my event_ids at index
                    end when
                end when
            end when
        end repeat
        variable kept_ids as array of number is []
        variable kept_kinds as array of number is []
        variable kept_subjects as array of text is []
        variable kept_relations as array of text is []
        variable kept_objects as array of text is []
        variable kept_polarities as array of number is []
        variable kept_sources as array of text is []
        variable kept_entities as array of text is []
        variable kept_sessions as array of number is []
        variable kept_targets as array of number is []
        repeat for index from 0 to (the length of my event_ids)
            value event_id is my event_ids at index
            variable reclaim as boolean is no
            repeat for each condemned in doomed
                when condemned equals event_id then
                    set reclaim to yes
                end when
            end repeat
            when not reclaim then
                append event_id to kept_ids
                append (my event_kinds at index) to kept_kinds
                append (my subjects at index) to kept_subjects
                append (my relations at index) to kept_relations
                append (my objects at index) to kept_objects
                append (my polarities at index) to kept_polarities
                append (my sources at index) to kept_sources
                append (my entities at index) to kept_entities
                append (my sessions at index) to kept_sessions
                append (my targets at index) to kept_targets
            end when
        end repeat
        value reclaimed is (the length of my event_ids) minus (the length of kept_ids)
        set my event_ids to kept_ids
        set my event_kinds to kept_kinds
        set my subjects to kept_subjects
        set my relations to kept_relations
        set my objects to kept_objects
        set my polarities to kept_polarities
        set my sources to kept_sources
        set my entities to kept_entities
        set my sessions to kept_sessions
        set my targets to kept_targets
        set my retained_from to horizon
        !!! The revision does not advance: compaction removes history rather
        !!! than adding to it, and an identifier a caller holds keeps meaning
        !!! what it meant.
        give build write_receipt with code being "ok", revision being my revision_value,
            evidence_id being reclaimed, event_id being my retained_from
    end paragraph

    public inspect receives authority as authority_registry, caller as access_context,
        grant_id as number, scope as text, evidence_id as number, as_of as number returns inspect_receipt begin paragraph
        value access is authority.authorize with caller being caller, grant_id being grant_id,
            scope being scope, operation being 1
        when access.code does not equal "ok" or scope does not equal my scope_name then
            give failed_inspect with code being "denied"
        end when
        when evidence_id is less than 1 or as_of is less than minus 1 then
            give failed_inspect with code being "invalid"
        end when
        variable snapshot as number is as_of
        when snapshot equals minus 1 then
            set snapshot to my revision_value
        end when
        when snapshot is greater than my revision_value then
            give failed_inspect with code being "invalid"
        end when
        when (my retained_count with nothing) is greater than access.work_limit then
            give failed_inspect with code being "limit"
        end when
        when evidence_id is greater than snapshot then
            give failed_inspect with code being "not_found"
        end when
        value position is my position_of with event_id being evidence_id
        !!! A reclaimed assertion reads as absent. ENI-0005 leaves telling
        !!! that apart from one that never existed to later work, so this
        !!! deliberately does not claim to know which it was.
        when position is less than 0 then
            give failed_inspect with code being "not_found"
        end when
        when (my event_kinds at position) does not equal 1 then
            give failed_inspect with code being "not_found"
        end when
        variable withdrawn_at as number is 0
        variable index as number is position plus 1
        repeat while index is less than (my retained_count with nothing)
            when (my event_ids at index) is at most snapshot and
                (my event_kinds at index) equals 2 and (my targets at index) equals evidence_id then
                set withdrawn_at to my event_ids at index
            end when
            set index to index plus 1
        end repeat
        value item is build evidence_item with id being evidence_id, subject being my subjects at position,
            relation being my relations at position, object_value being my objects at position,
            supports being (my polarities at position) equals 1, source being my sources at position,
            entity being my entities at position, session being my sessions at position,
            asserted_at being evidence_id, withdrawn_at being withdrawn_at
        give build inspect_receipt with code being "ok", revision being snapshot, evidence being item
    end paragraph
end class

public open_store receives scope as text returns evidence_store begin paragraph
    give build evidence_store with scope_name being scope, revision_value being 0,
        retained_from being 0, event_ids being [], event_kinds being [],
        subjects being [], relations being [], objects being [], polarities being [], sources being [],
        entities being [], sessions being [], targets being []
end paragraph

note if_test_mode
test_context receives entity as text returns access_context begin paragraph
    give build access_context with entity being entity, session being 1, audience being "enigma", tick being 1
end paragraph

note if_test_mode
test_claim returns proposition begin paragraph
    give build proposition with subject being "release:enigma", relation being "ready", object_value being "yes"
end paragraph

note suite "enigma.evidence"
opposing_reports_are_retained begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 15, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    value first is store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being yes, source being "test:passing", expected_revision being 0
    expect first.code equals "ok"
    value second is store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being no, source being "test:failing", expected_revision being 1
    expect second.code equals "ok"
    value result is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 128, max_evidence being 128
    expect result.state equals "contested"
    expect result.supporting equals 1
    expect result.opposing equals 1
    expect result.complete
    expect result.evidence_complete
    expect (result.evidence_ids at 0) equals 2
    expect (result.evidence_ids at 1) equals 1
end test

note suite "enigma.evidence"
withdrawal_preserves_history_and_empty_snapshot begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 7, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    value added is store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being yes, source being "test:report", expected_revision being 0
    value removed is store.withdraw with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being added.evidence_id, expected_revision being 1
    expect removed.revision equals 2
    value current is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 128, max_evidence being 128
    expect current.state equals "unknown"
    value historical is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being 1, max_work being 128, max_evidence being 128
    expect historical.state equals "supported"
    value empty is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being 0, max_work being 1, max_evidence being 1
    expect empty.state equals "unknown"
    expect empty.revision equals 0
    value old_item is store.inspect with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, as_of being 1
    value new_item is store.inspect with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, as_of being 2
    expect old_item.evidence.withdrawn_at equals 0
    expect new_item.evidence.withdrawn_at equals 2
end test

note suite "enigma.evidence"
partial_scan_and_output_truncation_are_distinct begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 3, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    evaluate store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being no, source being "test:old", expected_revision being 0
    evaluate store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being yes, source being "test:new", expected_revision being 1
    value partial is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 1, max_evidence being 1
    expect partial.state equals "incomplete"
    expect not partial.complete
    expect partial.supporting equals 1
    expect partial.opposing equals 0
    value capped is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 2, max_evidence being 1
    expect capped.state equals "contested"
    expect capped.complete
    expect not capped.evidence_complete
    expect (the length of capped.evidence_ids) equals 1
end test

note suite "enigma.evidence"
denial_precedes_validation_and_reveals_no_revision begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "other",
        operations being 15, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "private"
    value claim is empty_proposition with nothing
    value denied is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "private", claim being claim, as_of being 999, max_work being 0, max_evidence being 0
    expect denied.code equals "denied"
    expect denied.revision equals 0
    expect denied.inspected equals 0
    expect (the length of denied.evidence_ids) equals 0
    value item is store.inspect with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "private", evidence_id being 999, as_of being 999
    expect item.code equals "denied"
    expect item.evidence.source equals ""
end test

note suite "enigma.evidence"
failed_writes_and_other_authors_cannot_change_history begin test
    value authority is open_authority with nothing
    value first_grant is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 7, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value other_grant is authority.install with entity being "agent:b", session being 1, scope being "work",
        operations being 7, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value first_context is test_context with entity being "agent:a"
    value other_context is test_context with entity being "agent:b"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    value added is store.assert_claim with authority being authority, caller being first_context, grant_id being first_grant.grant_id,
        scope being "work", claim being claim, supports being yes, source being "test:original", expected_revision being 0
    value denied is store.withdraw with authority being authority, caller being other_context, grant_id being other_grant.grant_id,
        scope being "work", evidence_id being added.evidence_id, expected_revision being 1
    expect denied.code equals "denied"
    value stale is store.assert_claim with authority being authority, caller being first_context, grant_id being first_grant.grant_id,
        scope being "work", claim being claim, supports being no, source being "test:stale", expected_revision being 0
    expect stale.code equals "conflict"
    value result is store.resolve with authority being authority, caller being first_context, grant_id being first_grant.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 128, max_evidence being 128
    expect result.revision equals 1
    expect result.state equals "supported"
end test

note suite "enigma.evidence"
request_and_reply_mutation_do_not_rewrite_evidence begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 3, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    evaluate store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being yes, source being "test:source", expected_revision being 0
    set claim.object_value to "mutated"
    value item is store.inspect with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, as_of being minus 1
    expect item.evidence.object_value equals "yes"
    expect item.evidence.entity equals "agent:a"
    set item.evidence.source to "mutated"
    value fresh is store.inspect with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, as_of being minus 1
    expect fresh.evidence.source equals "test:source"
    value original is test_claim with nothing
    value result is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being original, as_of being minus 1, max_work being 128, max_evidence being 128
    set result.evidence_ids at 0 to 999
    value reread is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being original, as_of being minus 1, max_work being 128, max_evidence being 128
    expect (reread.evidence_ids at 0) equals 1
end test

note suite "enigma.evidence"
unknown_is_distinct_from_opposition_and_scopes_are_independent begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 3, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value other_issued is authority.install with entity being "agent:a", session being 1, scope being "other",
        operations being 3, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value other_store is open_store with scope being "other"
    value claim is test_claim with nothing
    evaluate other_store.assert_claim with authority being authority, caller being caller, grant_id being other_issued.grant_id,
        scope being "other", claim being claim, supports being yes, source being "test:other", expected_revision being 0
    value empty is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 1, max_evidence being 1
    expect empty.state equals "unknown"
    expect empty.revision equals 0
    expect empty.inspected equals 0
    value added is store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being no, source being "test:opposition", expected_revision being 0
    expect added.evidence_id equals 1
    value opposed is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 1, max_evidence being 1
    expect opposed.state equals "contradicted"
    expect opposed.supporting equals 0
    expect opposed.opposing equals 1
end test

note suite "enigma.evidence"
withdrawal_inspection_and_history_obey_current_grants begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 7, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value narrow is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 5, expires being 100, work_limit being 1, result_limit being 1, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    evaluate store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being yes, source being "test:first", expected_revision being 0
    evaluate store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being no, source being "test:second", expected_revision being 1
    value limited is store.withdraw with authority being authority, caller being caller, grant_id being narrow.grant_id,
        scope being "work", evidence_id being 1, expected_revision being 2
    expect limited.code equals "limit"
    expect limited.revision equals 0
    value inspection is store.inspect with authority being authority, caller being caller, grant_id being narrow.grant_id,
        scope being "work", evidence_id being 1, as_of being minus 1
    expect inspection.code equals "limit"
    expect inspection.evidence.source equals ""
    value removed is store.withdraw with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, expected_revision being 2
    expect removed.revision equals 3
    value duplicate is store.withdraw with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, expected_revision being 3
    expect duplicate.code equals "denied"
    value still_current is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 128, max_evidence being 128
    expect still_current.revision equals 3
    value expired is build access_context with entity being "agent:a", session being 1, audience being "enigma", tick being 100
    value historical is store.resolve with authority being authority, caller being expired, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being 1, max_work being 128, max_evidence being 128
    expect historical.code equals "denied"
    expect historical.revision equals 0
end test

note suite "enigma.evidence"
capacity_preserves_a_withdrawal_slot_and_explicit_compaction begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 31, expires being 100, work_limit being 1024, result_limit being 128, tick being 0
    value narrow is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 31, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    repeat for index from 0 to 1023
        value added is store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
            scope being "work", claim being claim, supports being yes, source being "test:bounded", expected_revision being index
        expect added.code equals "ok"
    end repeat
    value full is store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being no, source being "test:overflow", expected_revision being 1023
    expect full.code equals "capacity"
    expect full.revision equals 0
    expect (store.retained_count with nothing) equals 1023
    value result is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 1024, max_evidence being 128
    expect result.revision equals 1023
    expect result.supporting equals 1023
    expect result.opposing equals 0
    expect result.complete
    expect not result.evidence_complete
    expect (the length of result.evidence_ids) equals 128
    expect (result.evidence_ids at 0) equals 1023
    expect (result.evidence_ids at 127) equals 896
    !!! Raising the engine ceiling does not widen an installed grant.
    value denied_work is store.resolve with authority being authority, caller being caller, grant_id being narrow.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 1024, max_evidence being 128
    expect denied_work.code equals "denied"
    value partial is store.resolve with authority being authority, caller being caller, grant_id being narrow.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 128, max_evidence being 128
    expect partial.code equals "ok"
    expect not partial.complete
    expect partial.inspected equals 128
    expect (store.withdraw with authority being authority, caller being caller, grant_id being narrow.grant_id,
        scope being "work", evidence_id being 1, expected_revision being 1023).code equals "limit"
    expect (store.inspect with authority being authority, caller being caller, grant_id being narrow.grant_id,
        scope being "work", evidence_id being 1, as_of being minus 1).code equals "limit"
    expect (store.compact with authority being authority, caller being caller,
        grant_id being narrow.grant_id, scope being "work").code equals "limit"
    value invalid_work is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 1025, max_evidence being 128
    expect invalid_work.code equals "invalid"
    value invalid_output is store.resolve with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, as_of being minus 1, max_work being 1024, max_evidence being 129
    expect invalid_output.code equals "invalid"
    !!! Capacity leaves one event for a correction, without deleting history.
    value withdrawn is store.withdraw with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, expected_revision being 1023
    expect withdrawn.code equals "ok"
    expect withdrawn.event_id equals 1024
    expect (store.retained_count with nothing) equals 1024
    expect (store.withdraw with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 2, expected_revision being 1024).code equals "capacity"
    value withdraw_only is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 4, expires being 100, work_limit being 1024, result_limit being 128, tick being 1
    expect (store.compact with authority being authority, caller being caller,
        grant_id being withdraw_only.grant_id, scope being "work").code equals "denied"
    expect (store.retained_count with nothing) equals 1024
    value reclaimed is store.compact with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work"
    expect reclaimed.code equals "ok"
    expect reclaimed.evidence_id equals 2
    expect reclaimed.revision equals 1024
    expect reclaimed.event_id equals 1024
    expect (store.retained_count with nothing) equals 1022
    value appended is store.assert_claim with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", claim being claim, supports being no, source being "test:after-compaction", expected_revision being 1024
    expect appended.code equals "ok"
    expect appended.evidence_id equals 1025
    expect (store.retained_count with nothing) equals 1023
end test

note if_test_mode
other_claim returns proposition begin paragraph
    give build proposition with subject being "release:enigma", relation being "ready", object_value being "later"
end paragraph

note suite "enigma.evidence"
churn_no_longer_spends_the_ceiling_and_a_kept_assertion_still_counts begin test
    !!! ENI-0005. Before compaction the ceiling counted every write, so a
    !!! store that revised a claim repeatedly filled up and refused, which is
    !!! the workload the engine exists to serve. This asserts and withdraws
    !!! past the retained-event ceiling while an unwithdrawn assertion stays live.
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 31, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value kept is store.assert_claim with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", claim being (other_claim with nothing),
        supports being yes, source being "test:kept", expected_revision being minus 1
    expect kept.code equals "ok"
    variable cycle as number is 0
    repeat while cycle is less than 600
        value asserted is store.assert_claim with authority being authority, caller being caller,
            grant_id being issued.grant_id, scope being "work", claim being (test_claim with nothing),
            supports being yes, source being "test:churn", expected_revision being minus 1
        expect asserted.code equals "ok"
        value retracted is store.withdraw with authority being authority, caller being caller,
            grant_id being issued.grant_id, scope being "work", evidence_id being asserted.evidence_id,
            expected_revision being minus 1
        expect retracted.code equals "ok"
        value reclaimed is store.compact with authority being authority, caller being caller,
            grant_id being issued.grant_id, scope being "work"
        expect reclaimed.code equals "ok"
        !!! Each cycle writes two events and both come back.
        expect reclaimed.evidence_id equals 2
        set cycle to cycle plus 1
    end repeat
    !!! The clock advanced past the ceiling; what is held did not.
    expect store.revision_value equals 1201
    expect (store.retained_count with nothing) equals 1
    !!! The assertion nobody retracted is still evidence, and still resolves.
    value current is store.resolve with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", claim being (other_claim with nothing),
        as_of being minus 1, max_work being 128, max_evidence being 128
    expect current.state equals "supported"
    expect current.supporting equals 1
    expect current.complete
    expect (current.evidence_ids at 0) equals 1
    !!! The churned claim is gone, and saying so is exact: every pair that
    !!! held it was retired before it was reclaimed.
    value churned is store.resolve with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", claim being (test_claim with nothing),
        as_of being minus 1, max_work being 128, max_evidence being 128
    expect churned.state equals "unknown"
    expect churned.complete
end test

note suite "enigma.evidence"
a_view_below_the_horizon_is_incomplete_rather_than_wrong begin test
    value authority is open_authority with nothing
    value issued is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 31, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    value asserted is store.assert_claim with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", claim being claim, supports being yes,
        source being "test:first", expected_revision being 0
    expect asserted.code equals "ok"
    value retracted is store.withdraw with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", evidence_id being asserted.evidence_id,
        expected_revision being 1
    expect retracted.code equals "ok"
    !!! Before compaction the historical view is exact: supported at 1.
    value before is store.resolve with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", claim being claim, as_of being 1,
        max_work being 128, max_evidence being 128
    expect before.state equals "supported"
    expect before.complete
    value reclaimed is store.compact with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work"
    expect reclaimed.code equals "ok"
    expect reclaimed.evidence_id equals 2
    !!! The horizon moved only as far as the newest reclaimed withdrawal.
    expect store.retained_from equals 2
    !!! That same view can no longer be reconstructed, so it is refused rather
    !!! than answered unknown with every appearance of confidence.
    value after is store.resolve with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", claim being claim, as_of being 1,
        max_work being 128, max_evidence being 128
    expect after.state equals "incomplete"
    expect not after.complete
    !!! At or above the horizon the answer is exact again.
    value current is store.resolve with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", claim being claim, as_of being 2,
        max_work being 128, max_evidence being 128
    expect current.state equals "unknown"
    expect current.complete
    !!! Revision 0 needs no reconstruction: nothing had been written.
    value origin is store.resolve with authority being authority, caller being caller,
        grant_id being issued.grant_id, scope being "work", claim being claim, as_of being 0,
        max_work being 128, max_evidence being 128
    expect origin.state equals "unknown"
    expect origin.complete
    !!! A reclaimed assertion reads as absent and cannot be withdrawn again.
    expect (store.inspect with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, as_of being minus 1).code equals "not_found"
    expect (store.withdraw with authority being authority, caller being caller, grant_id being issued.grant_id,
        scope being "work", evidence_id being 1, expected_revision being minus 1).code equals "denied"
end test

note suite "enigma.evidence"
compaction_keeps_an_unwithdrawn_assertion_and_needs_authority begin test
    value authority is open_authority with nothing
    value writer is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 31, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    !!! Read-only authority cannot forget history.
    value reader is authority.install with entity being "agent:b", session being 1, scope being "work",
        operations being 1, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller is test_context with entity being "agent:a"
    value onlooker is test_context with entity being "agent:b"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    expect (store.assert_claim with authority being authority, caller being caller, grant_id being writer.grant_id,
        scope being "work", claim being claim, supports being yes, source being "test:kept",
        expected_revision being minus 1).code equals "ok"
    expect (store.compact with authority being authority, caller being onlooker,
        grant_id being reader.grant_id, scope being "work").code equals "denied"
    !!! Nothing is reclaimed, because nothing was retracted. Age is not a
    !!! reason to forget an assertion.
    value nothing_to_do is store.compact with authority being authority, caller being caller,
        grant_id being writer.grant_id, scope being "work"
    expect nothing_to_do.code equals "ok"
    expect nothing_to_do.evidence_id equals 0
    expect (store.retained_count with nothing) equals 1
    expect store.retained_from equals 0
    value current is store.resolve with authority being authority, caller being caller,
        grant_id being writer.grant_id, scope being "work", claim being claim, as_of being minus 1,
        max_work being 128, max_evidence being 128
    expect current.state equals "supported"
    expect current.complete
end test

note suite "enigma.evidence"
compaction_requires_scoped_maintenance_and_preserves_denied_history begin test
    value authority is open_authority with nothing
    value writer_a is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 7, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value writer_b is authority.install with entity being "agent:b", session being 1, scope being "work",
        operations being 7, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value withdrawer is authority.install with entity being "agent:a", session being 1, scope being "work",
        operations being 4, expires being 100, work_limit being 128, result_limit being 128, tick being 0
    value caller_a is test_context with entity being "agent:a"
    value caller_b is test_context with entity being "agent:b"
    value store is open_store with scope being "work"
    value claim is test_claim with nothing
    expect (store.assert_claim with authority being authority, caller being caller_a,
        grant_id being writer_a.grant_id, scope being "work", claim being claim, supports being yes,
        source being "test:own", expected_revision being 0).code equals "ok"
    expect (store.assert_claim with authority being authority, caller being caller_b,
        grant_id being writer_b.grant_id, scope being "work", claim being claim, supports being no,
        source being "test:other", expected_revision being 1).code equals "ok"
    expect (store.withdraw with authority being authority, caller being caller_a,
        grant_id being withdrawer.grant_id, scope being "work", evidence_id being 1,
        expected_revision being 2).code equals "ok"
    expect (store.withdraw with authority being authority, caller being caller_b,
        grant_id being writer_b.grant_id, scope being "work", evidence_id being 2,
        expected_revision being 3).code equals "ok"
    !!! Withdraw-own does not authorize forgetting either holder's history.
    value denied is store.compact with authority being authority, caller being caller_a,
        grant_id being withdrawer.grant_id, scope being "work"
    expect denied.code equals "denied"
    expect denied.revision equals 0
    expect denied.evidence_id equals 0
    expect denied.event_id equals 0
    expect (store.retained_count with nothing) equals 4
    expect store.retained_from equals 0
    value historical is store.resolve with authority being authority, caller being caller_b,
        grant_id being writer_b.grant_id, scope being "work", claim being claim, as_of being 2,
        max_work being 128, max_evidence being 128
    expect historical.state equals "contested"
    expect historical.complete
    value limited is authority.install with entity being "maintainer", session being 1, scope being "work",
        operations being 16, expires being 100, work_limit being 3, result_limit being 1, tick being 1
    value maintainer is test_context with entity being "maintainer"
    expect (store.compact with authority being authority, caller being maintainer,
        grant_id being limited.grant_id, scope being "work").code equals "limit"
    expect (store.retained_count with nothing) equals 4
    expect store.retained_from equals 0
    value maintenance is authority.install with entity being "maintainer", session being 1, scope being "work",
        operations being 16, expires being 100, work_limit being 128, result_limit being 1, tick being 1
    expect maintenance.code equals "ok"
    expect (store.compact with authority being authority, caller being maintainer,
        grant_id being maintenance.grant_id, scope being "other").code equals "denied"
    value reclaimed is store.compact with authority being authority, caller being maintainer,
        grant_id being maintenance.grant_id, scope being "work"
    expect reclaimed.code equals "ok"
    expect reclaimed.evidence_id equals 4
    expect reclaimed.revision equals 4
    expect reclaimed.event_id equals 4
    expect (store.retained_count with nothing) equals 0
    !!! A revoked maintenance grant cannot compact even an empty store.
    expect (authority.revoke with caller being maintainer, grant_id being maintenance.grant_id).code equals "ok"
    expect (store.compact with authority being authority, caller being maintainer,
        grant_id being maintenance.grant_id, scope being "work").code equals "denied"
end test
