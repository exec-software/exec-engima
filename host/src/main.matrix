book enigma.durable_host

read everything from nil.std.nildata
read everything from nil.std.core
read write_bytes_durable, read_regular_bytes, sync_directory,
    acquire_file_lock, create_private_directory,
    is_private_directory, is_private_regular_file, sha256_hex,
    read_line_option, write_error,
    dirname from nil.std.io
read byte_at, from_byte, char_at, contains from nil.std.text
read random_hex from nil.std.security
read arg_count, arg from nil.std.system
read stage_request from enigma.storage
read build_envelope, read_envelope, confirm_envelope,
    exact_object, field_text, field_number, field_value from enigma.persistence

!!! The Matrix durable host, as decided in ENI-0003.
!!!
!!! ENI-0002 split this slice between a Matrix worker and a Python POSIX host
!!! because the installed runtime had no directory synchronization, file
!!! locking, owner-only directory creation, metadata verdicts, or standalone
!!! digest. NIL-0028 through NIL-0030 supply those, so the host can be Matrix.
!!!
!!! The host/worker split was a language boundary, not an isolation boundary,
!!! and it is gone: staging now calls stage_request in process. The request
!!! envelope is still serialized and re-parsed on the way in. That is
!!! deliberate. It keeps the worker's strict validation exactly as qualified
!!! rather than introducing a second, looser path into the engine, and it
!!! costs one JSON round trip where it used to cost a process spawn.
!!!
!!! A fresh worker process per dispatch used to make retained authority
!!! structurally impossible. In one process that becomes a code invariant, so
!!! every dispatch re-derives its identity from the committed payload and
!!! nothing engine-side is carried across a commit. check_candidate keeps the
!!! checks the Python host performed on a worker reply; they are the only
!!! remaining verification that a staged candidate is a legitimate successor
!!! to committed state, and they run before publication.

checkpoint_name returns text begin paragraph
    give "checkpoint.json"
end paragraph

lock_name returns text begin paragraph
    give ".lock"
end paragraph

checkpoint_limit returns number begin paragraph
    give 1048576
end paragraph

request_limit returns number begin paragraph
    give 65536
end paragraph

max_generation returns number begin paragraph
    give 9223372036854775807
end paragraph

!!! Exactly 32 lowercase hexadecimal characters, matching the identifiers the
!!! Python host produced with secrets.token_hex(16).
hex_id_ok receives candidate as text returns boolean begin paragraph
    when (the length of candidate) does not equal 32 then
        give no
    end when
    repeat for index from 0 to 32
        value character is char_at with s being candidate, index being index
        when not (contains with s being "0123456789abcdef", needle being character) then
            give no
        end when
    end repeat
    give yes
end paragraph

bytes_of receives content as text returns array of override byte begin paragraph
    variable octets as array of override byte is []
    repeat for index from 0 to (the length of content)
        append (byte_at with s being content, index being index) becomes override byte to octets
    end repeat
    give octets
end paragraph

text_of receives octets as array of override byte returns text begin paragraph
    variable content as text is ""
    repeat for each octet in octets
        set content to content plus (from_byte with code being octet becomes number)
    end repeat
    give content
end paragraph

public metadata_view begin record
    field ok as boolean
    field database_id as text
    field incarnation as text
    field generation as number
end record

!!! The identity fields a candidate must carry. This is the Python host's
!!! _metadata: a payload that fails it is never published.
payload_metadata receives payload as text returns metadata_view begin paragraph
    value empty is build metadata_view with ok being no, database_id being "", incarnation being "", generation being 0
    when (the length of payload) is greater than (checkpoint_limit with nothing) then
        give empty
    end when
    value parsed is from_json with payload
    when parsed.is_error with nothing then
        give empty
    end when
    value root is parsed.unwrap with nothing
    value shape is kind with root
    when shape.is_error with nothing then
        give empty
    end when
    when (shape.unwrap with nothing) does not equal "object" then
        give empty
    end when
    value database_found is field_text with node being root, key being "database_id"
    value incarnation_found is field_text with node being root, key being "incarnation"
    value generation_found is field_number with node being root, key being "generation"
    when database_found.is_error with nothing or incarnation_found.is_error with nothing or
        generation_found.is_error with nothing then
        give empty
    end when
    value database_id is database_found.unwrap with nothing
    value incarnation is incarnation_found.unwrap with nothing
    value generation is generation_found.unwrap with nothing
    when not (hex_id_ok with candidate being database_id) or
        not (hex_id_ok with candidate being incarnation) then
        give empty
    end when
    when generation is less than 0 or generation is greater than (max_generation with nothing) then
        give empty
    end when
    give build metadata_view with ok being yes, database_id being database_id,
        incarnation being incarnation, generation being generation
end paragraph

public stage_view begin record
    field ok as boolean
    field code as text
    field payload as text
    field receipt as text
end record

stage_failed receives code as text returns stage_view begin paragraph
    give build stage_view with ok being no, code being code, payload being "", receipt being ""
end paragraph

!!! Everything the Python host checked on a worker reply before publishing it.
!!! In one process these are internal invariants, but they remain the only
!!! verification that a candidate is a legitimate successor to committed state.
check_candidate receives mode as text, committed as text, candidate as text,
    receipt as `Value`, database_id as text, incarnation as text returns text begin paragraph
    value receipt_code_found is field_text with node being receipt, key being "code"
    when receipt_code_found.is_error with nothing then
        give "worker_protocol"
    end when
    value receipt_code is receipt_code_found.unwrap with nothing
    !!! A denial neither mutates the payload nor claims an instance.
    when mode equals "apply" and candidate equals committed then
        value denial_keys as array of text is ["code", "instance", "generation"]
        when not (exact_object with node being receipt, keys being denial_keys) then
            give "worker_protocol"
        end when
        when receipt_code does not equal "denied" then
            give "worker_protocol"
        end when
        value instance_found is field_text with node being receipt, key being "instance"
        value generation_found is field_number with node being receipt, key being "generation"
        when instance_found.is_error with nothing or generation_found.is_error with nothing then
            give "worker_protocol"
        end when
        when (instance_found.unwrap with nothing) does not equal "" or
            (generation_found.unwrap with nothing) does not equal 0 then
            give "worker_protocol"
        end when
        give "ok"
    end when
    value observed is payload_metadata with payload being candidate
    when not observed.ok then
        give "worker_protocol"
    end when
    when observed.database_id does not equal database_id or
        observed.incarnation does not equal incarnation then
        give "worker_protocol"
    end when
    !!! A create starts at zero; anything else is exactly one past the
    !!! generation that is already committed.
    variable expected as number is 0
    when mode does not equal "create" then
        value current is payload_metadata with payload being committed
        when not current.ok then
            give "worker_protocol"
        end when
        set expected to current.generation plus 1
    end when
    when observed.generation does not equal expected then
        give "worker_protocol"
    end when
    value successful is receipt_code equals "ok" or receipt_code equals "ready" or receipt_code equals "created"
    when successful then
        value instance_found is field_text with node being receipt, key being "instance"
        value generation_found is field_number with node being receipt, key being "generation"
        value database_found is field_text with node being receipt, key being "database_id"
        when instance_found.is_error with nothing or generation_found.is_error with nothing or
            database_found.is_error with nothing then
            give "worker_protocol"
        end when
        when (instance_found.unwrap with nothing) does not equal incarnation or
            (generation_found.unwrap with nothing) does not equal observed.generation or
            (database_found.unwrap with nothing) does not equal database_id then
            give "worker_protocol"
        end when
    otherwise
        value refusals as array of text is ["denied", "invalid", "conflict", "limit", "capacity", "not_found"]
        variable known as boolean is no
        repeat for each refusal in refusals
            when receipt_code equals refusal then
                set known to yes
            end when
        end repeat
        when not known then
            give "worker_protocol"
        end when
        value instance_found is field_text with node being receipt, key being "instance"
        value generation_found is field_number with node being receipt, key being "generation"
        when instance_found.is_error with nothing or generation_found.is_error with nothing then
            give "worker_protocol"
        end when
        when (instance_found.unwrap with nothing) does not equal "" or
            (generation_found.unwrap with nothing) does not equal 0 then
            give "worker_protocol"
        end when
        value leaked is object_has with receipt, "database_id"
        when leaked.is_error with nothing then
            give "worker_protocol"
        end when
        when leaked.unwrap with nothing then
            give "worker_protocol"
        end when
    end when
    !!! A create or a recovery must report its own outcome, never a refusal.
    when mode equals "create" and receipt_code does not equal "created" then
        give "worker_protocol"
    end when
    when mode equals "recover" and receipt_code does not equal "ready" then
        give "worker_protocol"
    end when
    give "ok"
end paragraph

!!! Stage one dispatch against the committed payload. The envelope is built
!!! with the checked encoder, never concatenated, and handed to the same
!!! stage_request the separate worker process used to receive.
stage receives mode as text, committed as text, database_id as text,
    incarnation as text, scope as text, request as `Value` returns stage_view begin paragraph
    variable envelope is (new_object with nothing).unwrap with nothing
    value mode_node is string_value with mode
    value payload_node is string_value with committed
    value database_node is string_value with database_id
    value incarnation_node is string_value with incarnation
    value scope_node is string_value with scope
    when mode_node.is_error with nothing or payload_node.is_error with nothing or
        database_node.is_error with nothing or incarnation_node.is_error with nothing or
        scope_node.is_error with nothing then
        give stage_failed with code being "worker_protocol"
    end when
    set envelope to (object_set with envelope, "mode", (mode_node.unwrap with nothing)).unwrap with nothing
    set envelope to (object_set with envelope, "payload", (payload_node.unwrap with nothing)).unwrap with nothing
    set envelope to (object_set with envelope, "database_id", (database_node.unwrap with nothing)).unwrap with nothing
    set envelope to (object_set with envelope, "incarnation", (incarnation_node.unwrap with nothing)).unwrap with nothing
    set envelope to (object_set with envelope, "scope", (scope_node.unwrap with nothing)).unwrap with nothing
    set envelope to (object_set with envelope, "request", request).unwrap with nothing
    value serialized is to_json with envelope
    when serialized.is_error with nothing then
        give stage_failed with code being "worker_protocol"
    end when
    value reply_text is stage_request with input being (serialized.unwrap with nothing)
    value parsed is from_json with reply_text
    when parsed.is_error with nothing then
        give stage_failed with code being "worker_protocol"
    end when
    value reply is parsed.unwrap with nothing
    value reply_keys as array of text is ["code", "payload", "receipt"]
    when not (exact_object with node being reply, keys being reply_keys) then
        give stage_failed with code being "worker_protocol"
    end when
    value reply_code_found is field_text with node being reply, key being "code"
    value reply_payload_found is field_text with node being reply, key being "payload"
    when reply_code_found.is_error with nothing or reply_payload_found.is_error with nothing then
        give stage_failed with code being "worker_protocol"
    end when
    value reply_code is reply_code_found.unwrap with nothing
    when reply_code does not equal "ok" then
        !!! The engine reporting corrupt state is distinct from it breaking its
        !!! own protocol, and recovery must not confuse the two.
        when reply_code equals "corrupt" then
            give stage_failed with code being "corrupt"
        end when
        give stage_failed with code being "worker_protocol"
    end when
    value receipt is field_value with node being reply, key being "receipt"
    value receipt_shape is kind with receipt
    when receipt_shape.is_error with nothing then
        give stage_failed with code being "worker_protocol"
    end when
    when (receipt_shape.unwrap with nothing) does not equal "object" then
        give stage_failed with code being "worker_protocol"
    end when
    value candidate is reply_payload_found.unwrap with nothing
    value verdict is check_candidate with mode being mode, committed being committed,
        candidate being candidate, receipt being receipt, database_id being database_id,
        incarnation being incarnation
    when verdict does not equal "ok" then
        give stage_failed with code being verdict
    end when
    value receipt_text is to_json with receipt
    when receipt_text.is_error with nothing then
        give stage_failed with code being "worker_protocol"
    end when
    give build stage_view with ok being yes, code being "ok", payload being candidate,
        receipt being (receipt_text.unwrap with nothing)
end paragraph

!!! Publish a candidate durably. write_bytes_durable performs the whole
!!! ordering the Python host spelled out: a fresh private staging file, its
!!! synchronization, atomic replacement of the canonical name, and
!!! synchronization of the same publication directory. Nothing may acknowledge
!!! before this returns, and an uncertain publication is never a success.
commit receives directory as text, payload as text returns text begin paragraph
    value digest is sha256_hex with data being (bytes_of with content being payload)
    when digest.is_error with nothing then
        give "storage_error"
    end when
    value envelope is build_envelope with payload being payload,
        digest being (digest.unwrap with nothing)
    when envelope.code does not equal "ok" then
        give "storage_error"
    end when
    value written is write_bytes_durable with path being (directory plus "/" plus (checkpoint_name with nothing)),
        content being (bytes_of with content being envelope.content), replace being yes
    when written.is_error with nothing then
        give "storage_error"
    end when
    give "ok"
end paragraph

public load_view begin record
    field ok as boolean
    field payload as text
end record

!!! Recovery reads only the canonical checkpoint. read_regular_bytes opens it
!!! once without following its final component, rejects special files, and
!!! rejects input observed changing under it, which is the preflight the
!!! Python host assembled from fstat comparisons. A missing, malformed,
!!! truncated, mis-digested, or semantically invalid checkpoint fails closed;
!!! there is no fallback to an earlier snapshot.
load_checkpoint receives directory as text returns load_view begin paragraph
    value failed is build load_view with ok being no, payload being ""
    value canonical is directory plus "/" plus (checkpoint_name with nothing)
    !!! The Python host checked the opened descriptor: a regular file, owned by
    !!! the effective user, singly linked, exactly 0600. read_regular_bytes
    !!! rejects special files and will not follow the final component, but it
    !!! accepts a loose mode and a second hard link, so the preflight is
    !!! explicit here. It inspects a path, so it is weaker than a check on the
    !!! descriptor that is then read; publication keeps its own checked open.
    value private is is_private_regular_file with path being canonical
    when private.is_error with nothing then
        give failed
    end when
    when not (private.unwrap with nothing) then
        give failed
    end when
    value raw is read_regular_bytes with path being canonical,
        maximum_bytes being (checkpoint_limit with nothing)
    when raw.is_error with nothing then
        give failed
    end when
    value content is text_of with octets being (raw.unwrap with nothing)
    value decoded is read_envelope with content being content
    when decoded.code does not equal "ok" then
        give failed
    end when
    value digest is sha256_hex with data being (bytes_of with content being decoded.payload)
    when digest.is_error with nothing then
        give failed
    end when
    when (confirm_envelope with decoded being decoded, computed being (digest.unwrap with nothing)) does not equal "ok" then
        give failed
    end when
    value observed is payload_metadata with payload being decoded.payload
    when not observed.ok then
        give failed
    end when
    give build load_view with ok being yes, payload being decoded.payload
end paragraph

fail receives code as text returns override integer begin paragraph
    !!! A fixed public code, never a path or an underlying host diagnostic.
    evaluate write_error with s being "enigma store: " plus code
    give 1
end paragraph

empty_object returns `Value` begin paragraph
    give (new_object with nothing).unwrap with nothing
end paragraph

!!! Create an owner-only database directory and commit its first checkpoint.
!!! Creation is explicit and exclusive: an existing entry is never adopted.
run_init receives directory as text, scope as text returns override integer begin paragraph
    when (create_private_directory with path being directory).is_error with nothing then
        give fail with code being "exists"
    end when
    !!! One exclusive nonblocking lock, held for the whole session. Runtime
    !!! teardown closes it; releasing it early would shorten the window it
    !!! exists to protect.
    when (acquire_file_lock with path being (directory plus "/" plus (lock_name with nothing)), create being yes).is_error with nothing then
        give fail with code being "busy"
    end when
    value database_id is random_hex with byte_count being 16
    value incarnation is random_hex with byte_count being 16
    when database_id.is_error with nothing or incarnation.is_error with nothing then
        give fail with code being "storage_error"
    end when
    value staged is stage with mode being "create", committed being "",
        database_id being (database_id.unwrap with nothing),
        incarnation being (incarnation.unwrap with nothing), scope being scope,
        request being (empty_object with nothing)
    when not staged.ok then
        give fail with code being staged.code
    end when
    when (commit with directory being directory, payload being staged.payload) does not equal "ok" then
        give fail with code being "storage_error"
    end when
    !!! A newly created directory name is only durable once its parent is
    !!! synchronized, which publication of a file inside it does not do.
    when (sync_directory with path being (dirname with path being directory)).is_error with nothing then
        give fail with code being "storage_error"
    end when
    say staged.receipt
    give 0
end paragraph

!!! Recover an existing database, then serve requests until input closes.
run_serve receives directory as text returns override integer begin paragraph
    value private is is_private_directory with path being directory
    when private.is_error with nothing then
        give fail with code being "storage_error"
    end when
    when not (private.unwrap with nothing) then
        give fail with code being "unsafe_directory"
    end when
    !!! A second writer must be refused rather than queued, so the lock is
    !!! nonblocking and held for the whole session.
    when (acquire_file_lock with path being (directory plus "/" plus (lock_name with nothing)), create being no).is_error with nothing then
        give fail with code being "busy"
    end when
    value loaded is load_checkpoint with directory being directory
    when not loaded.ok then
        give fail with code being "corrupt"
    end when
    value current is payload_metadata with payload being loaded.payload
    when not current.ok then
        give fail with code being "corrupt"
    end when
    !!! A fresh incarnation, and never the one that was just loaded: recovery
    !!! retires saved session authority rather than reviving it.
    variable incarnation as text is ""
    repeat forever
        value drawn is random_hex with byte_count being 16
        when drawn.is_error with nothing then
            give fail with code being "storage_error"
        end when
        set incarnation to drawn.unwrap with nothing
        when incarnation does not equal current.incarnation then
            stop repeating
        end when
    end repeat
    value recovered is stage with mode being "recover", committed being loaded.payload,
        database_id being current.database_id, incarnation being incarnation, scope being "",
        request being (empty_object with nothing)
    when not recovered.ok then
        give fail with code being recovered.code
    end when
    when (commit with directory being directory, payload being recovered.payload) does not equal "ok" then
        give fail with code being "storage_error"
    end when
    variable committed as text is recovered.payload
    say recovered.receipt
    repeat forever
        value line is read_line_option with nothing
        when line.is_none with nothing then
            !!! Input closed: an ordinary shutdown, not a failure.
            give 0
        end when
        value request_text is line.unwrap with nothing
        when (the length of request_text) is greater than (request_limit with nothing) then
            give fail with code being "invalid_request"
        end when
        value parsed is from_json with request_text
        variable usable as boolean is not (parsed.is_error with nothing)
        variable request is empty_object with nothing
        when usable then
            set request to parsed.unwrap with nothing
            value shape is kind with request
            set usable to not (shape.is_error with nothing)
            when usable then
                set usable to (shape.unwrap with nothing) equals "object"
            end when
        end when
        !!! A request that is not an object is refused without touching
        !!! durable state, exactly as the Python host refused it.
        when not usable then
            say "{" plus quote plus "code" plus quote plus ":" plus quote plus "invalid" plus quote plus "}"
        end when
        when usable then
            value identity is payload_metadata with payload being committed
            when not identity.ok then
                give fail with code being "corrupt"
            end when
            value applied is stage with mode being "apply", committed being committed,
                database_id being identity.database_id, incarnation being identity.incarnation,
                scope being "", request being request
            when not applied.ok then
                give fail with code being applied.code
            end when
            !!! Reads and denials can advance the clock floor, so a candidate
            !!! that differs at all is committed before its receipt is
            !!! published. An unchanged candidate needs no write.
            when applied.payload does not equal committed then
                when (commit with directory being directory, payload being applied.payload) does not equal "ok" then
                    give fail with code being "storage_error"
                end when
                set committed to applied.payload
            end when
            say applied.receipt
        end when
    end repeat
    give 0
end paragraph

main returns override integer begin paragraph
    value count is arg_count with nothing
    when count is less than 2 then
        give fail with code being "invalid_arguments"
    end when
    value mode is arg with index being 0
    value directory is arg with index being 1
    variable scope as text is ""
    variable index as number is 2
    repeat forever
        when index is at least count then
            stop repeating
        end when
        value flag is arg with index being index
        when index plus 1 is at least count then
            give fail with code being "invalid_arguments"
        end when
        value supplied is arg with index being (index plus 1)
        when flag equals "--scope" then
            set scope to supplied
        end when
        !!! --target chose a worker route for the Python host. Staging is in
        !!! process now, so the flag is accepted and has no effect.
        when flag does not equal "--scope" and flag does not equal "--target" then
            give fail with code being "invalid_arguments"
        end when
        set index to index plus 2
    end repeat
    when mode equals "init" then
        when scope equals "" then
            give fail with code being "invalid_arguments"
        end when
        give run_init with directory being directory, scope being scope
    end when
    when mode equals "serve" then
        give run_serve with directory being directory
    end when
    give fail with code being "invalid_arguments"
end paragraph
